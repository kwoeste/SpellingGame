# Copy to .env.local for development. Never commit secrets.

# Auth.js / NextAuth
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=http://localhost:3000
# Optional aliases also accepted: GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, NEXTAUTH_SECRET, NEXTAUTH_URL

# Role allowlists (comma-separated, lowercased). Both env AND app_user rows must agree.
STUDENT_EMAILS=mae.woeste@gmail.com
ADMIN_EMAILS=kevinw@mcsteen.com,woeste.kevin@gmail.com,molly.woeste@gmail.com

# Neon Postgres (no hardcoded secrets). Production uses Neon main; previews should use a Neon branch.
DATABASE_URL=
DATABASE_URL_STUDENT=
DATABASE_URL_ADMIN=
DATABASE_URL_ASSISTANT=

# Public site URL used for Web3Forms thank-you redirects (no hardcoded maewoeste.com).
# If unset, the shop sets the redirect from window.location.origin.
NEXT_PUBLIC_SITE_URL=

# Optional override for the public Web3Forms access key (shop request form).
NEXT_PUBLIC_WEB3FORMS_KEY=

# Server-side "Report a problem" GitHub issue creator
GITHUB_ISSUE_TOKEN=
GITHUB_REPO=kwoeste/SpellingGame

# Religion content (open item). Assumed NABRE until Kevin/school confirm.
BIBLE_TRANSLATION=NABRE

# Test-only session minting is disabled unless NODE_ENV=test
# TEST_SESSION_SECRET=
