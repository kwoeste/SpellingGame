# Copy to .env.local for development. Never commit secrets.

# Auth.js / NextAuth
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=http://localhost:3000
# Vercel previews: set AUTH_TRUST_HOST=true
# AUTH_TRUST_HOST=true
# Optional aliases also accepted: GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, NEXTAUTH_SECRET, NEXTAUTH_URL

# Role allowlists (comma-separated, lowercased). Both env AND engine.app_user rows must agree.
STUDENT_EMAILS=mae.woeste@gmail.com
ADMIN_EMAILS=kevinw@mcsteen.com,woeste.kevin@gmail.com,molly.woeste@gmail.com

# Neon Postgres. Previews should use a Neon branch.
# DATABASE_URL is the owner: apply db/migrations/001, 002, 003 with it. It bypasses RLS.
# The app runs on the role-scoped URLs. Outside VERCEL_ENV=production it falls back to
# DATABASE_URL (with a warning, no RLS) when they are unset; production refuses that fallback.
# With no database at all, local dev uses in-memory storage (production refuses).
DATABASE_URL=
DATABASE_URL_STUDENT=
DATABASE_URL_ADMIN=
DATABASE_URL_ASSISTANT=

# Optional override for the public Web3Forms access key (shop request form).
# The thank-you redirect is set from the page origin; NEXT_PUBLIC_SITE_URL is not used.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Server-side "Report a problem" GitHub issue creator (signed-in users only, 5/hour).
# Without a token, reports are audited and return 202 but no issue is opened.
# Use a fine-grained token scoped to Issues: write on a PRIVATE repo.
GITHUB_ISSUE_TOKEN=
GITHUB_REPO=kwoeste/SpellingGame

# Religion content stays hidden from the student until reviewed. Assumed NABRE until confirmed.
BIBLE_TRANSLATION=NABRE

# Postgres RLS integration tests (throwaway local superuser; never Neon prod).
# TEST_PG_SUPERUSER_URL=postgresql://it_owner:it_owner@127.0.0.1/postgres
